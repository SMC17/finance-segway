      "repo:recordUnit": "case",
      "repo:recordCount": 54,
      "repo:dataElements": [
        {
          "name": "case_id",
          "definition": "The case's persistent identifier within this repository.",
          "datatype": "string"
        },
        {
          "name": "model_id",
          "definition": "The two-digit identifier of the domain model the case exercises.",
          "datatype": "string"
        },
        {
          "name": "case_type",
          "definition": "Whether the case exercises the model on a subject in its normal operating range (conventional) or under stress (adversarial).",
