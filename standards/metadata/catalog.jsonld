          "@id": "https://github.com/SMC17/finance-segway/standards/conformance/unit_and_currency_registry.json"
        }
      ],
      "dcat:theme": "model evidence",
      "dcat:keyword": [
        "financial modelling",
        "public filings",
        "evidence",
        "provenance"
      ],
      "dcat:distribution": [
        {
          "@type": "dcat:Distribution",
          "dcterms:title": "Public case index (JSON)",
