      "dcterms:identifier": "forecast-registry",
      "dcterms:title": "Out-of-sample forecast registry",
      "dcterms:description": "Predictions registered and content-hashed before their outcome was reportable, each declaring the naive baseline it must beat. Registration precedes resolution by construction: editing a registered forecast breaks its hash.",
      "dcterms:publisher": "SMC17 / finance-segway",
      "dcterms:license": {
        "@id": "https://spdx.org/licenses/MIT.html"
      },
      "dcterms:rights": "MIT licensed. Not investment advice and not validated for capital, fiduciary, or regulatory use.",
