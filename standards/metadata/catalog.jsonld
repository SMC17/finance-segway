        {
          "@id": "https://github.com/SMC17/finance-segway/standards/vocabulary"
        },
        {
          "@id": "https://github.com/SMC17/finance-segway/standards/conformance/unit_and_currency_registry.json"
        }
      ],
      "dcat:theme": "forward evidence",
      "dcat:keyword": [
        "forecasting",
        "out-of-sample",
        "skill scoring",
        "pre-registration"
      ],
      "dcat:distribution": [
        {
          "@type": "dcat:Distribution",
