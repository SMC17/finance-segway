        },
        {
          "name": "snapshot_sha256",
          "definition": "SHA-256 digest of the frozen source snapshot the case rests on.",
          "datatype": "string",
          "format": "hex-64"
        },
        {
          "name": "outcome",
          "definition": "The recorded metric, forecast value, realised value, and resolution status for the case.",
          "datatype": "object"
        }
      ],
