{
  "version": "2.1.0",
  "maturity_scale": {
    "M0": "Placeholder: path or concept only; no decision-useful model.",
    "M1": "Correct Skeleton: formula-driven archetype with basic controls and at least one verified core identity.",
    "M2": "Decision Model: integrated mechanics, scenarios or sensitivities, independent reference checks, and clear decision outputs.",
    "M3": "Institutional Underwriting: complete domain mechanics, multiple stakeholder perspectives, source register, visible checks, audit trail, and model-risk documentation.",
    "M4": "Maintained Production System: M3 model plus populated public instances, dated source snapshots, outcome monitoring, backtesting where applicable, and release/version discipline."
  },
  "promotion_policy": {
    "M1_to_M2": [
      "independent_reference_checks",
      "scenario_or_sensitivity",
      "decision_output",
      "no_external_links",
      "no_literal_excel_errors"
    ],
    "M2_to_M3": [
      "conceptual_soundness_documented",
      "source_register",
      "visible_checks",
      "stakeholder_views",
      "full_domain_engine_set",
      "effective_challenge_review"
    ],
    "M3_to_M4": [
      "two_or_more_instances",
      "append_only_refresh_history",
      "source_snapshots",
      "outcome_monitoring",
      "release_artifact_reproducibility"
    ]
  },
